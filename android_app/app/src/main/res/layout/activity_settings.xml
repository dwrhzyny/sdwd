<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="end" />

        <!-- משימות -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/section_tasks"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/text_current_tasks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edit_new_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:hint="@string/hint_new_task" />

        <Button
            android:id="@+id/button_add_task"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/button_add" />

        <!-- אפליקציות חסומות -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_blocked_apps"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_package_name_help"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="end" />

        <TextView
            android:id="@+id/text_current_blocked"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edit_blocked_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:hint="@string/hint_package_example" />

        <Button
            android:id="@+id/button_add_blocked"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/button_add" />

        <!-- טיימרים -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_timers"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:id="@+id/text_current_timers"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/edit_timer_package"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:hint="@string/hint_package_example" />

        <EditText
            android:id="@+id/edit_timer_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:inputType="number"
            android:hint="@string/hint_minutes_per_day" />

        <Button
            android:id="@+id/button_add_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/button_add" />

        <!-- סנכרון עם המחשב -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_sync"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_sync_help"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="end" />

        <EditText
            android:id="@+id/edit_sync_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:hint="@string/hint_sync_url" />

        <Button
            android:id="@+id/button_save_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/button_save" />

        <!-- תזכורות -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/section_reminders"
            android:textStyle="bold"
            android:gravity="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hint_reminder_help"
            android:textSize="12sp"
            android:textColor="#888888"
            android:gravity="end" />

        <EditText
            android:id="@+id/edit_reminder_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:inputType="number"
            android:hint="@string/hint_minutes_between_reminders" />

        <Button
            android:id="@+id/button_save_reminder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/button_save" />

    </LinearLayout>
</ScrollView>
